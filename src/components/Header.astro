---
const nav = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/work", label: "Work" },
  { href: "/projects", label: "Projects" },
];
---

<header class="masthead">
  <div class="wrap masthead-inner">
    <a href="/" class="mark">
      <span class="mark-name">NOAH ROBERTSON</span>
      <span class="mark-sub small-caps">Computer Engineer</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li>
          <details class="links-dropdown">
            <summary>Links</summary>
            <ul class="links-menu">
              <li>
                <a href="https://github.com/nhrobertson" target="_blank" rel="noopener noreferrer">GitHub &#8599;</a>
              </li>
              <li>
                <a href="https://www.linkedin.com/in/noah-robertson-330331211/" target="_blank" rel="noopener noreferrer">LinkedIn &#8599;</a>
              </li>
            </ul>
          </details>
        </li>
      </ul>
    </nav>

    <a href="/contact" class="contact-cta">Contact &#8594;</a>
  </div>
</header>

<style>
  .masthead {
    background: var(--garnet);
    color: var(--paper-on-garnet);
    border-bottom: 3px solid var(--ink);
  }

  .masthead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-4);
  }

  .mark {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--paper-on-garnet);
    line-height: 1.1;
  }

  .mark-name {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .mark-sub {
    color: var(--paper-on-garnet);
    opacity: 0.75;
  }

  .primary-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary-nav a {
    color: var(--paper-on-garnet);
    text-decoration: none;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
  }

  .primary-nav a:hover {
    text-decoration: underline;
  }

  .links-dropdown {
    position: relative;
  }

  .links-dropdown summary {
    cursor: pointer;
    color: var(--paper-on-garnet);
    font-size: 0.9375rem;
    list-style: none;
  }

  .links-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .links-dropdown summary::after {
    content: " \25BE";
  }

  .links-menu {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    background: var(--paper);
    color: var(--ink);
    border: var(--rule);
    list-style: none;
    margin: 0;
    padding: var(--space-2) 0;
    min-width: 10rem;
    z-index: 10;
  }

  .links-menu li a {
    display: block;
    color: var(--ink);
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .links-menu li a:hover {
    background: var(--ink-12);
  }

  .contact-cta {
    color: var(--red);
    background: var(--paper);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--paper);
    white-space: nowrap;
  }

  .contact-cta:hover {
    background: var(--ink);
    color: var(--paper);
  }

  @media (max-width: 40rem) {
    .masthead-inner {
      flex-wrap: wrap;
    }
    .primary-nav ul {
      gap: var(--space-4);
      flex-wrap: wrap;
    }
  }
</style>
