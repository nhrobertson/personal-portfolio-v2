---
interface Props {
  blocks: string[];
}
const { blocks } = Astro.props;
---

<div class="block-diagram mono" role="img" aria-label={`Functional block diagram: ${blocks.join(" to ")}`}>
  {
    blocks.map((block, i) => (
      <>
        <div class="block">{block}</div>
        {i < blocks.length - 1 && <div class="arrow" aria-hidden="true">&#8594;</div>}
      </>
    ))
  }
</div>

<style>
  .block-diagram {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-6);
    border: var(--rule);
    background: var(--ink-12);
  }

  .block {
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: var(--space-3) var(--space-4);
    font-size: 0.8125rem;
    text-align: center;
    flex: 1 1 8rem;
  }

  .arrow {
    color: var(--rust);
    font-size: 1.125rem;
    flex: 0 0 auto;
  }
</style>
