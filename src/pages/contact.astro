---
import BaseLayout from "../layouts/BaseLayout.astro";

const channels = [
  { label: "Email", value: "nhrobertson4@gmail.com", href: "mailto:nhrobertson4@gmail.com" },
  { label: "GitHub", value: "github.com/nhrobertson", href: "https://github.com/nhrobertson" },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/noah-robertson",
    href: "https://www.linkedin.com/in/noah-robertson-330331211/",
  },
];

const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? "";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Noah Robertson."
  section="04"
  page="01/01"
>
  <section class="wrap chapter">
    <p class="small-caps chapter-label">Back Cover &mdash; Contact Form</p>
    <h1>Contact</h1>

    <div class="order-grid">
      <form class="order-card" id="contact-form" novalidate>
        <p class="small-caps order-card-title">Order Card</p>

        <label class="field">
          <span class="mono field-label">Name</span>
          <input type="text" name="name" autocomplete="name" />
        </label>

        <label class="field">
          <span class="mono field-label">Email <span class="text-red">*</span></span>
          <input type="email" name="email" autocomplete="email" required />
        </label>

        <label class="field">
          <span class="mono field-label">Message <span class="text-red">*</span></span>
          <textarea name="message" rows="6" required></textarea>
        </label>

        <button type="submit" class="submit-btn mono">Submit &#8594;</button>

        <p class="form-status mono" id="form-status" role="status" aria-live="polite"></p>

        <p class="recaptcha-note mono small-caps">
          Protected by reCAPTCHA &mdash; Google
          <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Privacy</a>
          &amp;
          <a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer">Terms</a>
          apply.
        </p>
      </form>

      <table class="spec channels">
        <thead>
          <tr>
            <th scope="col">Channel</th>
            <th scope="col">Value</th>
          </tr>
        </thead>
        <tbody>
          {
            channels.map((c) => (
              <tr>
                <th scope="row">{c.label}</th>
                <td>
                  <a href={c.href} target="_blank" rel="noopener noreferrer">
                    {c.value}
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  {recaptchaSiteKey && <script is:inline async defer src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`} />}
</BaseLayout>

<script is:inline define:vars={{ recaptchaSiteKey }}>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("form-status");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    status.textContent = "";
    status.classList.remove("error");

    const data = new FormData(form);
    const email = data.get("email")?.toString().trim();
    const message = data.get("message")?.toString().trim();

    if (!email || !message) {
      status.textContent = "Email and message are required.";
      status.classList.add("error");
      return;
    }

    const submitBtn = form.querySelector(".submit-btn");
    submitBtn.disabled = true;
    status.textContent = "Sending…";

    try {
      let token = "";
      if (recaptchaSiteKey && window.grecaptcha) {
        token = await new Promise((resolve, reject) => {
          window.grecaptcha.ready(() => {
            window.grecaptcha
              .execute(recaptchaSiteKey, { action: "contact" })
              .then(resolve, reject);
          });
        });
      }

      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: data.get("name")?.toString().trim() ?? "",
          email,
          message,
          recaptchaToken: token,
        }),
      });

      if (!res.ok) throw new Error("Request failed");

      status.textContent = "Message received. Thanks for reaching out.";
      form.reset();
    } catch (err) {
      status.textContent = "Something went wrong sending that. Try emailing directly instead.";
      status.classList.add("error");
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .chapter {
    padding-block: var(--space-12) var(--space-16);
  }

  .chapter-label {
    margin-bottom: var(--space-2);
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin: 0 0 var(--space-8);
  }

  .order-grid {
    display: grid;
    grid-template-columns: minmax(0, 28rem) 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .order-card {
    border: 2px solid var(--ink);
    padding: var(--space-6);
  }

  .order-card-title {
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-2);
    border-bottom: var(--rule);
  }

  .field {
    display: block;
    margin-bottom: var(--space-4);
  }

  .field-label {
    display: block;
    margin-bottom: var(--space-1);
    color: var(--rust);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .field input,
  .field textarea {
    width: 100%;
    font-family: var(--font-display);
    font-size: 1rem;
    padding: var(--space-2) var(--space-3);
    border: var(--rule);
    background: var(--paper);
    color: var(--ink);
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus {
    outline: 2px solid var(--garnet);
    outline-offset: 1px;
  }

  .submit-btn {
    background: var(--garnet);
    color: var(--paper);
    border: 0;
    padding: var(--space-3) var(--space-6);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .submit-btn:hover {
    background: var(--ink);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-status {
    margin-top: var(--space-3);
    font-size: 0.8125rem;
    min-height: 1em;
  }

  .form-status.error {
    color: var(--red);
  }

  .recaptcha-note {
    margin-top: var(--space-6);
    color: var(--ink-35);
    font-size: 0.625rem;
  }

  .recaptcha-note a {
    color: var(--ink-35);
  }

  .channels {
    font-size: 0.9375rem;
  }

  .channels a {
    color: var(--garnet);
    text-decoration: none;
  }

  .channels a:hover {
    text-decoration: underline;
  }

  :global(.grecaptcha-badge) {
    visibility: hidden;
  }

  @media (max-width: 56rem) {
    .order-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
