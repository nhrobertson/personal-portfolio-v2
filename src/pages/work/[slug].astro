---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SpecTable from "../../components/SpecTable.astro";

import impactHat from "../../assets/work/impact-hat.jpg";
import nsiteConstruction from "../../assets/work/nsite-construction-site.jpeg";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const extraImages: Record<string, { src: ImageMetadata; alt: string }[]> = {
  "impact-forensics": [{ src: impactHat, alt: "Impact Forensics field gear" }],
  "nsite-ai": [{ src: nsiteConstruction, alt: "A construction site captured for Nsite.ai's 3D reconstruction pipeline" }],
};
const images = extraImages[entry.id];

const specRows: { label: string; value: string; href?: string }[] = [
  { label: "Role", value: data.role },
  { label: "Dates", value: `${data.dateStart}–${data.dateEnd}` },
  { label: "Stack", value: data.stack.join(", ") },
];
if (data.link) {
  const linkDisplay = data.link.replace(/^https?:\/\//, "").replace(/\/$/, "");
  specRows.push({ label: "Reference", value: linkDisplay, href: data.link });
}
---

<BaseLayout
  title={data.company}
  description={data.summary}
  section="02"
  page={`${String(data.order).padStart(2, "0")}/03`}
>
  <article class="wrap datasheet">
    <p class="small-caps chapter-label">
      <a href="/work">Work</a> / Entry {String(data.order).padStart(2, "0")}
    </p>
    <h1>{data.company}</h1>
    <p class="role-line mono">{data.role}</p>

    <div class="datasheet-grid">
      <div class="prose">
        <p class="summary">{data.summary}</p>
        <Content />

        <p class="small-caps outcomes-label">Outcomes</p>
        <table class="spec outcomes">
          <tbody>
            {
              data.outcomes.map((outcome, i) => (
                <tr>
                  <td class="mono outcome-num">{String(i + 1).padStart(2, "0")}</td>
                  <td>{outcome}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        {
          images && images.length > 0 && (
            <>
              <p class="small-caps outcomes-label">Images</p>
              <div class="gallery">
                {images.map((img) => (
                  <Image src={img.src} alt={img.alt} width={600} />
                ))}
              </div>
            </>
          )
        }
      </div>

      <aside class="margin-col">
        <SpecTable title="Entry Specifications" rows={specRows} />
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .datasheet {
    padding-block: var(--space-12) var(--space-16);
  }

  .chapter-label {
    margin-bottom: var(--space-2);
  }

  .chapter-label a {
    color: var(--rust);
    text-decoration: none;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin: 0 0 var(--space-1);
  }

  .role-line {
    color: var(--rust);
    margin: 0 0 var(--space-8);
  }

  .datasheet-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) 16rem;
    gap: var(--space-12);
    align-items: start;
  }

  .summary {
    font-size: 1.125rem;
    color: var(--ink-60);
  }

  .outcomes-label {
    margin-top: var(--space-8);
    margin-bottom: var(--space-2);
  }

  .outcomes {
    font-size: 0.9375rem;
  }

  .outcome-num {
    color: var(--red);
    width: 2.5rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-2);
  }

  .gallery :global(img) {
    border: var(--rule-faint);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
    height: auto;
  }

  .margin-col {
    position: sticky;
    top: var(--space-8);
  }

  @media (max-width: 56rem) {
    .datasheet-grid {
      grid-template-columns: 1fr;
    }
    .margin-col {
      position: static;
    }
  }
</style>
